{
  "name": "BusinessFlow AI - Inquiry Processing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "businessflow-inquiry",
        "responseMode": "lastNode",
        "responseData": "allEntries"
      },
      "name": "Inquiry Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 100]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "url": "http://localhost:4003/api/inquiries",
        "jsonParameters": true,
        "bodyParametersJson": "{ \"text\": \"{{ $json.text }}\" }"
      },
      "name": "Send to BusinessFlow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [460, 100]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "{{ $json.category }}",
              "operation": "equals",
              "value2": "escalation"
            },
            {
              "value1": "{{ $json.category }}",
              "operation": "equals",
              "value2": "billing"
            }
          ]
        },
        "options": {
          "failOnError": false
        }
      },
      "name": "Escalation Check",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [640, 100]
    },
    {
      "parameters": {
        "to": "manager@example.com",
        "subject": "BusinessFlow AI - Escalation Required",
        "text": "Inquiry requires escalation:\\n\\nText: {{ $json.text }}\\nCategory: {{ $json.category }}\\nUrgency: {{ $json.urgency }}"
      },
      "name": "Notify Manager",
      "type": "n8n-nodes-base.sendEmail",
      "typeVersion": 1,
      "position": [840, 100],
      "credentials": {
        "smtp": "smtp-credentials"
      }
    },
    {
      "parameters": {
        "to": "support-team@example.com",
        "subject": "BusinessFlow AI - New Inquiry",
        "text": "New inquiry:\\n\\n{{ $json.text }}\\nCategory: {{ $json.category }}\\nUrgency: {{ $json.urgency }}\\n\\nReview in BusinessFlow dashboard."
      },
      "name": "Notify Support Team",
      "type": "n8n-nodes-base.sendEmail",
      "typeVersion": 1,
      "position": [840, 300],
      "credentials": {
        "smtp": "smtp-credentials"
      }
    }
  ],
  "connections": {
    "Inquiry Webhook": {
      "main": [
        [
          {
            "node": "Send to BusinessFlow",
